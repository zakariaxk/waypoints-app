    "Drivers who aren't your friends choose whether to show up at all, and when they do, only a half-mile area is shared. Your own setting works the same way.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conductores que no son tus amigos eligen si aparecer o no, y cuando lo hacen solo se comparte un área de media milla. Tu propio ajuste funciona igual."
          }
        }
      }
    },
