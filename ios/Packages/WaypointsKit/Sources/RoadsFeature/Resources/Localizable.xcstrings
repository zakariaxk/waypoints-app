{
  "sourceLanguage": "en",
  "strings": {
    "%@ of %@ stretches of road here. Counted on this phone only.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@ tramos de carretera aquí. Contado solo en este teléfono."
          }
        }
      }
    },
    "A road can't start or end in one of your home zones. Move the handles.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carretera no puede empezar ni terminar en una de tus zonas personales. Mueve los controles."
          }
        }
      }
    },
    "Add a road from your saved roads below.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carretera de tus carreteras guardadas de abajo."
          }
        }
      }
    },
