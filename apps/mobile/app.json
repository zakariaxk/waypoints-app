{
  "expo": {
    "name": "Waypoints",
    "slug": "waypoints",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "waypoints",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Waypoints needs your location to share it with your session group."
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    }
  }
}
