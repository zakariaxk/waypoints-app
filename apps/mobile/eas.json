{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "GOOGLE_MAPS_API_KEY": ""
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://waypoints-api.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://waypoints-api.onrender.com"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://waypoints-api.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://waypoints-api.onrender.com"
      }
    }
  }
}
