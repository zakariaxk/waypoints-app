# Server-only. Do not expose this value to Expo or any browser/mobile bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional only for legacy HS256 projects. Modern asymmetric projects use JWKS automatically.
# SUPABASE_JWT_SECRET=legacy-jwt-secret
PERSISTENCE_BATCH_SIZE=100
PERSISTENCE_FLUSH_MS=500
