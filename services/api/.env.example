# Waypoints API — environment configuration
#
# Every variable read by the backend is listed here. The set of keys must stay
# in sync with the Zod schema in src/config.ts — CI fails on drift (see
# scripts/check-env-sync.ts). All values below are the built-in defaults; copy
# to .env and override as needed. .env is gitignored — never commit real secrets.

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0

# --- Real-time / presence tuning ---
# Min ms between accepted LOC_UPDATE messages per participant.
LOC_UPDATE_MIN_INTERVAL_MS=900
# Seconds of inactivity before a participant is marked stale, then offline.
STALE_THRESHOLD_SEC=10
OFFLINE_THRESHOLD_SEC=30
# Ring-buffer capacity (events retained per session for reconnect replay).
EVENT_BUFFER_CAPACITY=1000

# --- Session lifecycle ---
# Empty sessions older than this (ms) are swept. Default: 2 hours.
SESSION_TTL_MS=7200000
# Interval (ms) between cleanup sweeps.
CLEANUP_INTERVAL_MS=60000

# --- Limits ---
MAX_PARTICIPANTS=50
MAX_DISPLAY_NAME_LENGTH=30

# --- CORS ---
# Unset  -> reflect the request origin (dev convenience).
# Single -> https://app.example.com
# List   -> https://app.example.com,https://staging.example.com
CORS_ORIGIN=

# --- Logging ---
# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# development -> pretty logs; production -> JSON logs
NODE_ENV=development

# Interval between WS heartbeat ping sweeps (ms). Connections that miss two
# consecutive sweeps are terminated as half-open.
WS_HEARTBEAT_INTERVAL_MS=15000

# Metres from the destination within which ARRIVAL_PING is accepted.
ARRIVAL_RADIUS_M=50

# Chat rate limit: max messages per participant per window.
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=5000

# Join rate limit: max POST /sessions/join attempts per IP per window.
JOIN_RATE_LIMIT_COUNT=20
JOIN_RATE_LIMIT_WINDOW_MS=60000
